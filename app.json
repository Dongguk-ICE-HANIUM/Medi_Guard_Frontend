{
  "expo": {
    "name": "MediGuard",
    "slug": "MediGuard",
    "owner": "minxxo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.dgu.MediGuard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#ffffff",
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dgu.MediGuard",
      "infoPlist": {
        "NSFaceIDUsageDescription": "이 앱은 안전한 로그인을 위해 Face ID를 사용합니다.",
        "KAKAO_APP_KEY": "9b1878ed023f9fe90b323586f8d7493d",
        "KAKAO_APP_SCHEME": "kakao9b1878ed023f9fe90b323586f8d7493d",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["kakao9b1878ed023f9fe90b323586f8d7493d"]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.700573267904-du9htj8c2g5bpd44o34oh79g55lvsdt6"
            ]
          }
        ],
        "LSApplicationQueriesSchemes": ["kakaokompassauth", "kakaolink"]
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.dgu.MediGuard"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "이 앱은 안전한 로그인을 위해 Face ID를 사용합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "34ab4866-d2d9-477c-852a-fd46a7bee282"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/34ab4866-d2d9-477c-852a-fd46a7bee282"
    }
  }
}
